class circle:
    def __init__ (self):
        x=int(input("Enter radius: "))
        self.radius=x
    def display(self):
        print("Area of Circle is: ",3.14*self.radius**2)

a=int(input("Enter the num of circles: "))
circles=[]
for i in range(a):
    c=circle()
    circles.append(c)
    c.display()
    print("_________________________________")
